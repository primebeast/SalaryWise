@model SalaryWise.ViewModels.ChangePasswordViewModel
@{ViewData["Title"] = "Change Password";}
<div class="sw-auth-page">
    <div class="sw-auth-card">
        <div class="text-center mb-4">
            <div class="sw-auth-logo">🔑</div>
            <h1 class="sw-auth-title">Change Password</h1>
        </div>
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert sw-alert-error mb-3"></div>
            <div class="sw-form-group">
                <label asp-for="CurrentPassword" class="sw-label"></label>
                <div class="sw-input-wrap"><i class="bi bi-lock sw-input-icon"></i><input asp-for="CurrentPassword" class="sw-input" /></div>
                <span asp-validation-for="CurrentPassword" class="sw-validation"></span>
            </div>
            <div class="sw-form-group">
                <label asp-for="NewPassword" class="sw-label"></label>
                <div class="sw-input-wrap"><i class="bi bi-lock-fill sw-input-icon"></i><input asp-for="NewPassword" class="sw-input" /></div>
                <span asp-validation-for="NewPassword" class="sw-validation"></span>
            </div>
            <div class="sw-form-group">
                <label asp-for="ConfirmPassword" class="sw-label"></label>
                <div class="sw-input-wrap"><i class="bi bi-shield-lock sw-input-icon"></i><input asp-for="ConfirmPassword" class="sw-input" /></div>
                <span asp-validation-for="ConfirmPassword" class="sw-validation"></span>
            </div>
            <button type="submit" class="btn sw-btn-primary w-100 rounded-pill">Change Password</button>
        </form>
        <p class="text-center mt-3 sw-auth-footer"><a asp-controller="Profile" asp-action="Index" class="sw-link">← Back to Profile</a></p>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
