@model SalaryWise.ViewModels.ResetPasswordViewModel
@{ViewData["Title"] = "Reset Password";}
<div class="sw-auth-page">
    <div class="sw-auth-card">
        <div class="text-center mb-4">
            <div class="sw-auth-logo">🔒</div>
            <h1 class="sw-auth-title">Set New Password</h1>
        </div>
        <form asp-action="ResetPassword" method="post">
            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert sw-alert-error mb-3"></div>
            <div class="sw-form-group">
                <label asp-for="Password" class="sw-label"></label>
                <div class="sw-input-wrap"><i class="bi bi-lock sw-input-icon"></i><input asp-for="Password" class="sw-input" /></div>
                <span asp-validation-for="Password" class="sw-validation"></span>
            </div>
            <div class="sw-form-group">
                <label asp-for="ConfirmPassword" class="sw-label"></label>
                <div class="sw-input-wrap"><i class="bi bi-lock-fill sw-input-icon"></i><input asp-for="ConfirmPassword" class="sw-input" /></div>
                <span asp-validation-for="ConfirmPassword" class="sw-validation"></span>
            </div>
            <button type="submit" class="btn sw-btn-primary w-100 rounded-pill">Reset Password</button>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
