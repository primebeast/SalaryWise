@{ViewData["Title"] = "Check Email";}
<div class="sw-auth-page">
    <div class="sw-auth-card text-center">
        <div class="sw-auth-logo">📧</div>
        <h1 class="sw-auth-title">Check Your Email</h1>
        <p class="sw-auth-sub mb-4">If an account exists for that email, a reset link has been generated.</p>
        @if (TempData["ResetLink"] != null)
        {
            <div class="alert sw-alert-success text-start mb-3">
                <strong>Dev Mode – Reset Link:</strong><br/>
                <a href="@TempData["ResetLink"]" class="sw-link small text-break">@TempData["ResetLink"]</a>
            </div>
        }
        <a asp-action="Login" class="btn sw-btn-primary rounded-pill px-4">Back to Login</a>
    </div>
</div>
