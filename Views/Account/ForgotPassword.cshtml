@model SalaryWise.ViewModels.ForgotPasswordViewModel
@{ViewData["Title"] = "Forgot Password";}
<div class="sw-auth-page">
    <div class="sw-auth-card">
        <div class="text-center mb-4">
            <div class="sw-auth-logo">🔑</div>
            <h1 class="sw-auth-title">Forgot Password</h1>
            <p class="sw-auth-sub">Enter your email to receive a reset link</p>
        </div>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert sw-alert-error mb-3"></div>
            <div class="sw-form-group">
                <label asp-for="Email" class="sw-label"></label>
                <div class="sw-input-wrap">
                    <i class="bi bi-envelope sw-input-icon"></i>
                    <input asp-for="Email" class="sw-input" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="sw-validation"></span>
            </div>
            <button type="submit" class="btn sw-btn-primary w-100 rounded-pill">
                <i class="bi bi-send me-2"></i>Send Reset Link
            </button>
        </form>
        <p class="text-center mt-3 sw-auth-footer">
            <a asp-action="Login" class="sw-link">Back to Login</a>
        </p>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
